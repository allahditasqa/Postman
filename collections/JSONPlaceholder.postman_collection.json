{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "description": "Postman collection with assertions against https://jsonplaceholder.typicode.com (fake public API).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "TC_POSTS_01 - GET /posts returns status 200 and 100 posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Returns 100 posts', () => pm.expect(pm.response.json()).to.have.lengthOf(100));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_02 - GET /posts/1 returns post 1 that matches the JSON schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const schema = { type: 'object', required: ['userId','id','title','body'], properties: { userId: {type:'integer'}, id: {type:'integer'}, title: {type:'string'}, body: {type:'string'} } };",
                  "pm.test('Matches JSON schema', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('id equals requested id', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('postId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_03 - GET /posts?userId=1 returns 10 posts that all belong to user 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All posts belong to user 1', () => pm.response.json().forEach(p => pm.expect(p.userId).to.eql(1)));",
                  "pm.test('10 posts for user 1', () => pm.expect(pm.response.json()).to.have.lengthOf(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_04 - POST /posts creates a post and returns status 201 with the new id 101",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Echoes title and userId', () => { pm.expect(body.title).to.eql('QA demo'); pm.expect(body.userId).to.eql(7); });",
                  "pm.test('Gets new id 101', () => pm.expect(body.id).to.eql(101));",
                  "pm.environment.set('createdId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA demo\",\n  \"body\": \"created from Postman\",\n  \"userId\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_05 - PUT /posts/1 replaces the post and returns status 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('updated title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"updated title\",\n  \"body\": \"updated body\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_06 - PATCH /posts/1 changes only the title and returns status 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only title changed in response', () => { const b = pm.response.json(); pm.expect(b.title).to.eql('patched'); pm.expect(b.id).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"patched\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "TC_POSTS_07 - DELETE /posts/1 returns status 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "TC_USERS_01 - GET /users/1 returns the user Bret with a valid email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json();",
                  "pm.test('Has expected fields', () => { pm.expect(u).to.have.all.keys('id','name','username','email','address','phone','website','company'); });",
                  "pm.test('Email looks valid', () => pm.expect(u.email).to.match(/^[^@]+@[^@]+$/));",
                  "pm.test('username is Bret', () => pm.expect(u.username).to.eql('Bret'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Negative",
      "item": [
        {
          "name": "TC_NEGATIVE_01 - GET /posts/9999 returns status 404 and an empty object",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is empty object', () => pm.expect(pm.response.json()).to.eql({}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "9999"
              ]
            }
          }
        },
        {
          "name": "TC_NEGATIVE_02 - GET /does-not-exist returns status 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            }
          }
        }
      ]
    }
  ]
}
